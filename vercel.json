{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/ceu", "destination": "/index.html?marca=ceu" },
    { "source": "/ceu/", "destination": "/index.html?marca=ceu" },
    { "source": "/ama", "destination": "/ama.html?marca=ama" },
    { "source": "/ama/", "destination": "/ama.html?marca=ama" }
  ],
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(index|ceu|ama)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
